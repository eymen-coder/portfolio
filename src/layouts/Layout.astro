---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Eymen Gülmez · Portfolio',
	description = 'Portfolio von Eymen Gülmez, Wirtschaftsinformatik-Student an der FH Dortmund: Projekte, Über mich und Kontakt.',
} = Astro.props;
---

<html lang="de">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="bg-paper text-ink antialiased">
		<slot />
		<script>
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					}
				},
				{ threshold: 0.15 },
			);
			document
				.querySelectorAll('.reveal, .reveal-scale, .reveal-clip')
				.forEach((el) => observer.observe(el));

			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const fxEls = Array.from(document.querySelectorAll<HTMLElement>('.scroll-fx'));

			if (fxEls.length && !reduceMotion) {
				let lastY = window.scrollY;
				let lastT = performance.now();
				let skew = 0;

				const loop = (t: number) => {
					const dt = Math.max(t - lastT, 1);
					const dy = window.scrollY - lastY;
					const velocity = dy / dt;
					const targetSkew = Math.max(-6, Math.min(6, velocity * 14));
					skew += (targetSkew - skew) * 0.12;
					if (Math.abs(skew) < 0.03) skew = 0;

					const viewportH = window.innerHeight;
					for (const el of fxEls) {
						const rect = el.getBoundingClientRect();
						const progress = (rect.top + rect.height / 2 - viewportH / 2) / viewportH;
						const offset = progress * -24;
						el.style.transform = `translateY(${offset}px) skewY(${skew.toFixed(2)}deg) scale(1.1)`;
					}

					lastY = window.scrollY;
					lastT = t;
					requestAnimationFrame(loop);
				};
				requestAnimationFrame(loop);
			}
		</script>
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
</style>
