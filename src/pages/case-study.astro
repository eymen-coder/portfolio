---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MermaidDiagram from '../components/MermaidDiagram.astro';
import {
	istProcess,
	sollProcess,
	gantt,
	facts,
	methods,
	approach,
	weaknesses,
	risks,
	stakeholders,
	results,
	reflexion,
	ausgangslage,
	sollText,
} from '../data/case-study';

const jumpLinks = [
	{ href: '#ausgangslage', label: 'Ausgangslage' },
	{ href: '#vorgehen', label: 'Vorgehen' },
	{ href: '#ist-prozess', label: 'Ist-Prozess' },
	{ href: '#soll-konzept', label: 'Soll-Konzept' },
	{ href: '#projektplanung', label: 'Planung' },
	{ href: '#risiken', label: 'Risiken' },
	{ href: '#stakeholder', label: 'Stakeholder' },
	{ href: '#nutzen', label: 'Nutzen' },
	{ href: '#reflexion', label: 'Reflexion' },
];
---

<Layout
	title="SAP S/4HANA Case Study · Eymen Gülmez"
	description="Konzeptstudie zur Einführung von SAP S/4HANA in einem mittelständischen Handelsunternehmen: Prozessanalyse, Soll-Konzept und Projektplanung."
>
	<Header />
	<main>
		<section class="reveal mx-auto max-w-4xl px-6 pt-20 sm:pt-28">
			<a href="/#projekte" class="text-sm font-medium text-accent hover:text-ink">← Zurück zum Portfolio</a>
			<p class="mt-8 inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 text-xs font-medium text-ink/60">
				<span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
				Konzeptstudie · Fiktives Fallbeispiel
			</p>
			<h1 class="mt-5 text-4xl font-semibold leading-[1.1] tracking-tight text-ink sm:text-5xl">
				SAP S/4HANA-Einführung bei einem mittelständischen Handelsunternehmen
			</h1>
			<p class="mt-5 max-w-2xl text-lg text-ink/60">
				Eine selbst erarbeitete Fallstudie: Wie würde ich als Schnittstelle zwischen IT und
				Business eine ERP-Einführung analysieren und planen? Das Unternehmen und die Zahlen sind
				fiktiv, Vorgehen und Methodik sind es nicht — sie bauen auf meiner Hochschulanalyse zu{' '}
				<a href="/#projekte" class="text-accent hover:text-ink">SAP S/4HANA-Betriebsmodellen</a> auf.
			</p>
			<div class="mt-6 flex flex-wrap gap-2">
				{
					methods.map((m) => (
						<span class="rounded-full bg-ink/8 px-3 py-1 text-xs text-ink/60">{m}</span>
					))
				}
			</div>

			<div class="mt-10 grid grid-cols-2 gap-4 border-t border-line pt-8 sm:grid-cols-4">
				{
					facts.map((f) => (
						<div>
							<p class="text-2xl font-semibold text-accent">{f.value}</p>
							<p class="mt-1 text-xs text-ink/50">{f.label}</p>
						</div>
					))
				}
			</div>

			<a
				href="/sap-case-study.pdf"
				download
				class="mt-8 flex items-center justify-between gap-4 rounded-2xl border border-line bg-ink/[0.03] p-5 transition-colors hover:border-accent/40"
			>
				<span class="flex items-center gap-4">
					<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M12 3v12m0 0-4-4m4 4 4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</span>
					<span>
						<span class="block text-sm font-semibold text-ink">Vollständige Dokumentation als PDF</span>
						<span class="block text-xs text-ink/50">Mit Titelblatt und Inhaltsverzeichnis, zum Ausdrucken oder Weiterleiten</span>
					</span>
				</span>
				<span class="text-sm font-medium text-accent">Herunterladen →</span>
			</a>
		</section>

		<nav class="subnav-below-header sticky z-40 mt-10 overflow-x-auto border-y border-line bg-paper/90 backdrop-blur">
			<ul class="mx-auto flex max-w-4xl gap-6 whitespace-nowrap px-6 py-3 text-sm text-ink/60">
				{
					jumpLinks.map((link) => (
						<li>
							<a href={link.href} class="transition-colors hover:text-accent">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<section id="ausgangslage" class="reveal mx-auto max-w-4xl scroll-mt-32 px-6 py-12">
			<h2 class="text-2xl font-semibold tracking-tight text-ink">Ausgangslage</h2>
			<p class="mt-4 text-ink/60">{ausgangslage}</p>
		</section>

		<section id="vorgehen" class="reveal mx-auto max-w-4xl scroll-mt-32 px-6 py-12">
			<h2 class="text-2xl font-semibold tracking-tight text-ink">Mein Vorgehen</h2>
			<p class="mt-4 text-ink/60">Vier Schritte, bevor überhaupt über konkrete Systemkonfiguration gesprochen wird.</p>
			<div class="mt-8 grid gap-8 sm:grid-cols-2">
				{
					approach.map((step, i) => (
						<div>
							<span class="text-xs font-medium text-accent">{String(i + 1).padStart(2, '0')}</span>
							<h3 class="mt-2 font-semibold text-ink">{step.title}</h3>
							<p class="mt-2 text-sm text-ink/60">{step.text}</p>
						</div>
					))
				}
			</div>
		</section>

		<section id="ist-prozess" class="reveal mx-auto max-w-4xl scroll-mt-32 px-6 py-12">
			<h2 class="text-2xl font-semibold tracking-tight text-ink">Ist-Prozess</h2>
			<p class="mt-4 text-ink/60">Der aktuelle Beschaffungsprozess, Schritt für Schritt.</p>
			<div class="mt-6">
				<button
					type="button"
					class="diagram-trigger flex w-full items-center justify-between rounded-2xl border border-line bg-paper/60 px-6 py-4 text-left transition-colors hover:border-accent/40"
					aria-expanded="false"
					aria-controls="ist-process-panel"
				>
					<span class="text-sm font-medium text-ink">Diagramm anzeigen</span>
					<span class="diagram-chevron text-accent">▾</span>
				</button>
				<div id="ist-process-panel" class="diagram-panel">
					<div class="pt-4">
						<MermaidDiagram code={istProcess} id="ist-process" />
					</div>
				</div>
			</div>
		</section>

		<section class="reveal mx-auto max-w-4xl px-6 py-12">
			<h2 class="text-2xl font-semibold tracking-tight text-ink">Schwachstellen</h2>
			<ul class="mt-6 grid gap-4 sm:grid-cols-2">
				{weaknesses.map((item) => <li class="rounded-2xl border border-line p-5 text-ink/70">{item}</li>)}
			</ul>
		</section>

		<section id="soll-konzept" class="reveal mx-auto max-w-4xl scroll-mt-32 px-6 py-12">
			<h2 class="text-2xl font-semibold tracking-tight text-ink">Soll-Konzept</h2>
			<p class="mt-4 text-ink/60">{sollText}</p>
			<div class="mt-6">
				<button
					type="button"
					class="diagram-trigger flex w-full items-center justify-between rounded-2xl border border-line bg-paper/60 px-6 py-4 text-left transition-colors hover:border-accent/40"
					aria-expanded="false"
					aria-controls="soll-process-panel"
				>
					<span class="text-sm font-medium text-ink">Diagramm anzeigen</span>
					<span class="diagram-chevron text-accent">▾</span>
				</button>
				<div id="soll-process-panel" class="diagram-panel">
					<div class="pt-4">
						<MermaidDiagram code={sollProcess} id="soll-process" />
					</div>
				</div>
			</div>
		</section>

		<section id="projektplanung" class="reveal mx-auto max-w-4xl scroll-mt-32 px-6 py-12">
			<h2 class="text-2xl font-semibold tracking-tight text-ink">Projektplanung</h2>
			<p class="mt-4 text-ink/60">Grobplanung über sechs Phasen, von der Analyse bis zur Hypercare-Phase nach Go-Live.</p>
			<div class="mt-6">
				<MermaidDiagram code={gantt} id="gantt-chart" />
			</div>
		</section>

		<section id="risiken" class="reveal mx-auto max-w-4xl scroll-mt-32 px-6 py-12">
			<h2 class="text-2xl font-semibold tracking-tight text-ink">Risikomatrix</h2>
			<div class="mt-6 overflow-x-auto rounded-2xl border border-line">
				<table class="w-full min-w-[640px] text-left text-sm">
					<thead>
						<tr class="border-b border-line text-ink/50">
							<th class="px-5 py-4 font-medium">Risiko</th>
							<th class="px-5 py-4 font-medium">Wahrscheinlichkeit</th>
							<th class="px-5 py-4 font-medium">Auswirkung</th>
							<th class="px-5 py-4 font-medium">Gegenmaßnahme</th>
						</tr>
					</thead>
					<tbody>
						{
							risks.map((r, i) => (
								<tr class={i !== risks.length - 1 ? 'border-b border-line' : ''}>
									<td class="px-5 py-4 text-ink">{r.risk}</td>
									<td class="px-5 py-4 text-ink/70">{r.probability}</td>
									<td class="px-5 py-4 text-ink/70">{r.impact}</td>
									<td class="px-5 py-4 text-ink/60">{r.mitigation}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</section>

		<section id="stakeholder" class="reveal mx-auto max-w-4xl scroll-mt-32 px-6 py-12">
			<h2 class="text-2xl font-semibold tracking-tight text-ink">Stakeholder-Analyse</h2>
			<div class="mt-6 grid gap-4 sm:grid-cols-2">
				{
					stakeholders.map((s) => (
						<div class="rounded-2xl border border-line p-5">
							<p class="text-xs font-medium text-accent">{s.quadrant}</p>
							<p class="mt-2 text-ink/70">{s.people}</p>
						</div>
					))
				}
			</div>
		</section>

		<section id="nutzen" class="reveal mx-auto max-w-4xl scroll-mt-32 px-6 py-12">
			<h2 class="text-2xl font-semibold tracking-tight text-ink">Erwarteter Nutzen</h2>
			<p class="mt-2 text-sm text-ink/50">Geschätzte Werte für dieses fiktive Fallbeispiel, keine belegten Praxiszahlen.</p>
			<div class="mt-6 grid gap-6 sm:grid-cols-3">
				{
					results.map((r) => (
						<div class="rounded-2xl border border-line p-6 text-center">
							<p class="text-3xl font-semibold text-accent">{r.value}</p>
							<p class="mt-2 text-sm text-ink/60">{r.label}</p>
						</div>
					))
				}
			</div>
		</section>

		<section id="reflexion" class="reveal mx-auto max-w-4xl scroll-mt-32 px-6 py-12">
			<h2 class="text-2xl font-semibold tracking-tight text-ink">Was ich daraus mitnehme</h2>
			<p class="mt-4 max-w-2xl text-ink/60">{reflexion}</p>
		</section>

		<section class="reveal mx-auto max-w-4xl px-6 py-16">
			<div class="rounded-3xl bg-ink px-8 py-12 text-center sm:px-16">
				<h2 class="text-2xl font-semibold tracking-tight text-paper sm:text-3xl">
					Neugierig auf mehr?
				</h2>
				<p class="mx-auto mt-3 max-w-lg text-paper/60">
					Das ist genau die Art von Arbeit, die mich reizt: zwischen Prozess, Technik und Business
					vermitteln. Lass uns reden.
				</p>
				<a
					href="/#kontakt"
					class="mt-6 inline-block rounded-full border border-paper/20 px-6 py-3 text-sm font-semibold text-paper transition-colors hover:border-accent hover:text-accent"
				>
					Kontakt aufnehmen
				</a>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	document.querySelectorAll<HTMLButtonElement>('.diagram-trigger').forEach((btn) => {
		btn.addEventListener('click', () => {
			const panel = document.getElementById(btn.getAttribute('aria-controls') || '');
			const isOpen = btn.getAttribute('aria-expanded') === 'true';
			btn.setAttribute('aria-expanded', String(!isOpen));
			panel?.classList.toggle('is-open', !isOpen);
		});
	});
</script>
