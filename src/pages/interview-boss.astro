---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InterviewBossGame from '../components/InterviewBossGame.astro';

const howItWorks = [
	{
		title: 'Fragen-Pool mit gewichteten Antworten',
		text: 'Jede Interviewfrage hat drei Antworten mit unterschiedlichem Schaden: eine starke, eine mittelmäßige, eine riskante mit Konter.',
	},
	{
		title: 'Kampf-Feedback per Sound & Animation',
		text: 'Treffer, Kritische Treffer und Konter erzeugen eigene Sounds (per Web Audio API synthetisiert) und Screen-Shake, ganz ohne externe Audiodateien.',
	},
	{
		title: 'State Machine statt Zufall',
		text: 'Vorschau-, Kampf- und Endzustand sind sauber getrennt, damit sich das Spiel jederzeit erweitern lässt (mehr Fragen, neue Bosse, Schwierigkeitsgrade).',
	},
];
---

<Layout
	title="Interview-Boss-Battle · Eymen Gülmez"
	description="Ein kleines Browser-Spiel: Besiege den Recruiter-Boss mit den richtigen Interview-Antworten. Mit Sound-Effekten, Screen-Shake und Sarkasmus."
>
	<Header />
	<main>
		<section class="reveal mx-auto max-w-4xl px-6 pt-20 sm:pt-28">
			<a href="/#projekte" class="text-sm font-medium text-accent hover:text-ink">← Zurück zum Portfolio</a>
			<p class="mt-8 inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 text-xs font-medium text-ink/60">
				<span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
				Für-Spaß-Projekt · Mit Sound
			</p>
			<h1 class="mt-5 text-4xl font-semibold leading-[1.1] tracking-tight text-ink sm:text-5xl">
				Interview-Boss-Battle
			</h1>
			<p class="mt-5 max-w-2xl text-lg text-ink/60">
				Weil Bewerbungsgespräche sich manchmal wie ein Boss-Kampf anfühlen: Besiege den
				Recruiter-Boss, indem du die überzeugendsten Antworten auf klassische Interviewfragen
				wählst. Schlechte Antworten lassen ihn zurückschlagen.
			</p>
			<div class="mt-6 flex flex-wrap gap-2">
				{
					['Vanilla JavaScript', 'Web Audio API', 'Game State', 'Ein bisschen Sarkasmus'].map((tag) => (
						<span class="rounded-full bg-ink/8 px-3 py-1 text-xs text-ink/60">{tag}</span>
					))
				}
			</div>
		</section>

		<section class="reveal mx-auto max-w-4xl px-6 py-12">
			<h2 class="text-2xl font-semibold tracking-tight text-ink">Kampf starten</h2>
			<p class="mt-3 text-ink/60">Ton an für das volle Erlebnis. 🔊</p>
			<div class="mt-6">
				<InterviewBossGame />
			</div>
		</section>

		<section class="reveal mx-auto max-w-4xl px-6 py-12">
			<h2 class="text-2xl font-semibold tracking-tight text-ink">Wie es funktioniert</h2>
			<div class="mt-8 grid gap-8 sm:grid-cols-3">
				{
					howItWorks.map((step, i) => (
						<div>
							<span class="text-xs font-medium text-accent">{String(i + 1).padStart(2, '0')}</span>
							<h3 class="mt-2 font-semibold text-ink">{step.title}</h3>
							<p class="mt-2 text-sm text-ink/60">{step.text}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="reveal mx-auto max-w-4xl px-6 py-16">
			<div class="rounded-3xl bg-ink px-8 py-12 text-center sm:px-16">
				<h2 class="text-2xl font-semibold tracking-tight text-paper sm:text-3xl">
					Im echten Interview mach ich's überzeugender.
				</h2>
				<p class="mx-auto mt-3 max-w-lg text-paper/60">
					Kein Recruiter-Boss, aber gerne ein echtes Gespräch. Lass uns reden.
				</p>
				<a
					href="/#kontakt"
					class="mt-6 inline-block rounded-full border border-paper/20 px-6 py-3 text-sm font-semibold text-paper transition-colors hover:border-accent hover:text-accent"
				>
					Kontakt aufnehmen
				</a>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
