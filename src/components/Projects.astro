---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

const featured = projects.find((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<section id="projekte" class="reveal mx-auto max-w-5xl scroll-mt-24 px-6 py-24">
	<h2 class="text-3xl font-semibold tracking-tight text-ink">Projekte</h2>

	{
		featured && (
			<article class="reveal mt-10 grid overflow-hidden rounded-2xl border border-accent/30 bg-paper md:grid-cols-2">
				{featured.image && (
					<div class="relative overflow-hidden">
						<img
							src={featured.image}
							alt=""
							class="h-56 w-full object-cover md:h-full"
							loading="lazy"
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-paper/40 to-transparent md:bg-gradient-to-r" />
					</div>
				)}
				<div class="flex flex-col p-8">
					<span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-accent/15 px-3 py-1 text-xs font-semibold text-accent">
						★ Hauptprojekt
					</span>
					<h3 class="mt-4 text-2xl font-semibold text-ink">{featured.title}</h3>
					{featured.highlight && (
						<p class="mt-2 inline-flex w-fit items-center gap-2 text-xs font-medium text-accent">
							<span class="h-1.5 w-1.5 rounded-full bg-accent" />
							{featured.highlight}
						</p>
					)}
					<p class="mt-4 text-sm leading-relaxed text-ink/60">{featured.description}</p>

					{featured.learning && (
						<div class="mt-5 rounded-xl border border-line bg-surface/60 p-4">
							<p class="text-xs font-semibold uppercase tracking-widest text-accent/80">
								Was ich gelernt habe
							</p>
							<p class="mt-2 text-sm leading-relaxed text-ink/55">{featured.learning}</p>
						</div>
					)}

					<div class="mt-5 flex flex-wrap gap-2">
						{featured.tags.map((tag) => (
							<span class="rounded-full bg-ink/8 px-2.5 py-1 text-xs text-ink/60">{tag}</span>
						))}
					</div>

					{(featured.link || featured.repo) && (
						<div class="mt-6 flex gap-4 text-sm">
							{featured.link && (
								<a href={featured.link} class="font-semibold text-accent hover:text-ink">
									Live ansehen →
								</a>
							)}
							{featured.repo && (
								<a href={featured.repo} class="font-medium text-ink/60 hover:text-ink">
									Code →
								</a>
							)}
						</div>
					)}
				</div>
			</article>
		)
	}

	<div class="mt-6 grid items-stretch gap-6 sm:grid-cols-2">
		{rest.map((project, index) => <ProjectCard project={project} index={index} />)}
	</div>
</section>
