---
const links = [
	{ href: '#ueber-mich', label: 'Über mich' },
	{ href: '#projekte', label: 'Projekte' },
	{ href: '#kontakt', label: 'Kontakt' },
];
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-paper/85 backdrop-blur">
	<nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
		<a href="#" class="text-lg font-semibold tracking-tight text-ink">Eymen Gülmez</a>
		<ul class="flex gap-8 text-sm text-ink/70">
			{
				links.map((link) => (
					<li>
						<a href={link.href} class="transition-colors hover:text-accent">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
