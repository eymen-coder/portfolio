---
import LimelightNav from './LimelightNav.astro';

const name = 'Eymen Gülmez';
const letters = name.split('').map((ch) => (ch === ' ' ? ' ' : ch));
---

<header class="header-autohide sticky top-0 z-50 border-b border-line/80 bg-paper/85 backdrop-blur transition-transform duration-300">
	<nav class="relative mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4">
		<a href="/" class="logo flex items-center gap-2.5 text-lg font-semibold tracking-tight text-ink">
			<span class="logo-mark inline-flex h-9 w-9 shrink-0 items-center justify-center" aria-hidden="true">
				<svg viewBox="0 0 44 44" class="h-full w-full" fill="none">
					<rect
						x="1.5"
						y="1.5"
						width="41"
						height="41"
						rx="13"
						stroke="var(--color-accent)"
						stroke-opacity="0.55"
						stroke-width="1.5"
					></rect>
					<text
						x="22"
						y="19.5"
						text-anchor="middle"
						dominant-baseline="central"
						font-family="'General Sans', 'Arial', sans-serif"
						font-weight="600"
						font-size="17"
						letter-spacing="-1"
						fill="currentColor">EG</text>
					<rect class="logo-bar" x="14.5" y="30" width="15" height="2" rx="1" fill="var(--color-accent)"></rect>
				</svg>
			</span>
			<span class="logo-word hidden md:inline">
				{letters.map((ch, i) => (
					<span class="letter" style={`transition-delay: ${i * 18}ms`}>
						{ch}
					</span>
				))}
			</span>
		</a>

		<LimelightNav />
	</nav>
</header>

<script>
	// Header versteckt sich beim Runterscrollen, erscheint beim Hochscrollen
	const header = document.querySelector<HTMLElement>('.header-autohide');
	let lastY = window.scrollY;
	let headerHidden = false;

	function updateHeaderVisibility() {
		const currentY = window.scrollY;
		const scrollingDown = currentY > lastY;
		const pastThreshold = currentY > 100;

		if (scrollingDown && pastThreshold && !headerHidden) {
			header?.style.setProperty('transform', 'translateY(-100%)');
			document.body.classList.add('header-hidden');
			headerHidden = true;
		} else if ((!scrollingDown || !pastThreshold) && headerHidden) {
			header?.style.setProperty('transform', 'translateY(0)');
			document.body.classList.remove('header-hidden');
			headerHidden = false;
		}
		lastY = currentY;
	}

	function showHeader() {
		if (!headerHidden) return;
		header?.style.setProperty('transform', 'translateY(0)');
		document.body.classList.remove('header-hidden');
		headerHidden = false;
	}

	let ticking = false;
	document.addEventListener(
		'scroll',
		() => {
			if (!ticking) {
				requestAnimationFrame(() => {
					updateHeaderVisibility();
					ticking = false;
				});
				ticking = true;
			}
		},
		{ passive: true },
	);

	// Header auch einblenden, wenn die Maus an den oberen Bildschirmrand fährt
	document.addEventListener(
		'mousemove',
		(event) => {
			if (event.clientY <= 80) showHeader();
		},
		{ passive: true },
	);
</script>
