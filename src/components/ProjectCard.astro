---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	index: number;
}

const { project, index } = Astro.props;
---

<article
	class="tilt-card reveal group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-paper transition-colors hover:border-accent/40"
	style={`transition-delay: ${index * 90}ms`}
>
	{project.image && <img src={project.image} alt="" class="h-32 w-full object-cover" loading="lazy" />}
	<div class="flex flex-1 flex-col p-8">
		<span class="text-xs font-medium text-accent">{String(index + 1).padStart(2, '0')}</span>
		<h3 class="mt-3 text-lg font-semibold text-ink">{project.title}</h3>
		{
			project.highlight && (
				<p class="mt-3 inline-flex items-center gap-2 self-start rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent">
					<span class="h-1.5 w-1.5 rounded-full bg-accent" />
					{project.highlight}
				</p>
			)
		}
		<p class="mt-3 text-sm text-ink/60">{project.description}</p>
		<div class="mt-5 flex flex-wrap gap-2">
			{
				project.tags.map((tag) => (
					<span class="rounded-full bg-ink/8 px-2.5 py-1 text-xs text-ink/60">{tag}</span>
				))
			}
		</div>
		{
			(project.link || project.repo) && (
				<div class="mt-5 flex gap-4 text-sm">
					{project.link && (
						<a
							href={project.link}
							download={project.download ? true : undefined}
							class="font-medium text-accent hover:text-ink"
						>
							{project.download ? 'PDF herunterladen' : 'Live ansehen'} →
						</a>
					)}
					{project.repo && (
						<a href={project.repo} class="font-medium text-ink/60 hover:text-ink">
							Code →
						</a>
					)}
				</div>
			)
		}
	</div>
</article>
