---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	index: number;
}

const { project, index } = Astro.props;
---

<article class="group rounded-2xl border border-line bg-paper p-8 transition-colors hover:border-accent/40">
	<span class="text-xs font-medium text-accent">{String(index + 1).padStart(2, '0')}</span>
	<h3 class="mt-3 text-lg font-semibold text-ink">{project.title}</h3>
	<p class="mt-2 text-sm text-ink/60">{project.description}</p>
	<div class="mt-5 flex flex-wrap gap-2">
		{
			project.tags.map((tag) => (
				<span class="rounded-full bg-ink/8 px-2.5 py-1 text-xs text-ink/60">{tag}</span>
			))
		}
	</div>
	{
		(project.link || project.repo) && (
			<div class="mt-5 flex gap-4 text-sm">
				{project.link && (
					<a href={project.link} class="font-medium text-accent hover:text-ink">
						Live ansehen →
					</a>
				)}
				{project.repo && (
					<a href={project.repo} class="font-medium text-ink/60 hover:text-ink">
						Code →
					</a>
				)}
			</div>
		)
	}
</article>
