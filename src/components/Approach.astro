---
const steps = [
	{
		title: 'Verstehen',
		text: 'Anforderungen und Prozesse analysieren, bevor die erste Zeile Code geschrieben wird.',
	},
	{
		title: 'Umsetzen',
		text: 'Sauber strukturierte Lösungen bauen, mit Blick auf Wartbarkeit statt schnellem Hack.',
	},
	{
		title: 'Testen & Verbessern',
		text: 'Ergebnisse prüfen, Feedback einholen und iterativ nachschärfen.',
	},
];
---

<section class="reveal mx-auto max-w-5xl scroll-mt-24 px-6 py-24">
	<h2 class="text-3xl font-semibold tracking-tight text-ink">Wie ich arbeite</h2>
	<div class="mt-10 grid gap-10 sm:grid-cols-3">
		{
			steps.map((step, i) => (
				<div>
					<span class="text-xs font-medium text-accent">{String(i + 1).padStart(2, '0')}</span>
					<h3 class="mt-3 font-semibold text-ink">{step.title}</h3>
					<p class="mt-2 text-sm text-ink/60">{step.text}</p>
				</div>
			))
		}
	</div>
</section>
