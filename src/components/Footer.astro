---
const year = new Date().getFullYear();

const nav = [
	{ label: 'Über mich', href: '/#ueber-mich' },
	{ label: 'Lebenslauf', href: '/#lebenslauf' },
	{ label: 'Projekte', href: '/#projekte' },
	{ label: 'Wie ich arbeite', href: '/#wie-ich-arbeite' },
	{ label: 'Kontakt', href: '/#kontakt' },
];

const socials = [
	{ label: 'GitHub', href: 'https://github.com/eymen-coder' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/eymen-g%C3%BClmez-0669a9263/' },
	{ label: 'E-Mail', href: 'mailto:eymenguelmez@outlook.de' },
];
---

<footer class="border-t border-line">
	<div class="mx-auto max-w-5xl px-6 py-14">
		<div class="grid gap-10 sm:grid-cols-[1.5fr_1fr_1fr]">
			<div>
				<p class="text-lg font-semibold tracking-tight text-ink">Eymen Gülmez</p>
				<p class="mt-2 max-w-xs text-sm leading-relaxed text-ink/40">
					Wirtschaftsinformatik trifft IT-Beratung — ich übersetze zwischen beiden.
				</p>
				<div class="mt-6 flex gap-3">
					{
						socials.map((s) => (
							<a
								href={s.href}
								class="rounded-full border border-line px-3.5 py-1.5 text-xs font-medium text-ink/50 transition-colors hover:border-accent/40 hover:text-accent"
							>
								{s.label}
							</a>
						))
					}
				</div>
			</div>

			<div>
				<p class="text-xs font-medium uppercase tracking-widest text-ink/25">Navigation</p>
				<ul class="mt-4 space-y-2.5">
					{
						nav.map((l) => (
							<li>
								<a
									href={l.href}
									class="text-sm text-ink/45 transition-colors hover:text-accent"
								>
									{l.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<p class="text-xs font-medium uppercase tracking-widest text-ink/25">Kontakt</p>
				<ul class="mt-4 space-y-2.5">
					<li class="text-sm text-ink/45">Dortmund, Deutschland</li>
					<li>
						<a
							href="mailto:eymenguelmez@outlook.de"
							class="text-sm text-ink/45 transition-colors hover:text-accent"
						>
							eymenguelmez@outlook.de
						</a>
					</li>
					<li>
						<a
							href="tel:+4917620183591"
							class="text-sm text-ink/45 transition-colors hover:text-accent"
						>
							+49 176 20183591
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-8">
			<p class="text-xs text-ink/25">© {year} Eymen Gülmez. Alle Rechte vorbehalten.</p>
			<a
				href="https://www.eymensportfolio.de"
				class="text-xs text-ink/25 transition-colors hover:text-accent"
			>
				eymensportfolio.de
			</a>
		</div>
	</div>
</footer>
