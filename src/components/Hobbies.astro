---
import { Image } from 'astro:assets';
import sport from '../assets/photos/hobbies/sport.jpg';
import coding from '../assets/photos/hobbies/coding.jpg';
import networking from '../assets/photos/hobbies/networking.jpg';
import lesezirkel from '../assets/photos/hobbies/lesezirkel.jpg';

const hobbies = [
	{
		title: 'Sport',
		text: 'Joggen und Kraftsport zum Kopf-Freikriegen, der Ausgleich, wenn der Code mal nicht mitspielt.',
		image: sport,
	},
	{
		title: 'Coding',
		text: 'Auch nach Feierabend sitze ich gerne am Rechner: eigene Projekte, neue Frameworks, einfach weil es Spaß macht.',
		image: coding,
	},
	{
		title: 'Networking',
		text: 'Neue Leute, neue Perspektiven: Ich rede gerne über Tech, Business und alles dazwischen.',
		image: networking,
	},
	{
		title: 'Lesezirkel',
		text: 'Von Sachbüchern bis Romanen: Regelmäßiger Austausch hält den Kopf offen für neue Ideen.',
		image: lesezirkel,
	},
];
---

<section class="reveal mx-auto max-w-5xl scroll-mt-24 px-6 py-24">
	<h2 class="text-3xl font-semibold tracking-tight text-ink">Neben der Arbeit</h2>
	<p class="mt-3 max-w-xl text-ink/60">Ein paar Dinge, die mich abseits von Code und Excel-Tabellen beschäftigen.</p>

	<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
		{
			hobbies.map((hobby, i) => (
				<div
					class="reveal hobby-card group overflow-hidden rounded-2xl border border-line"
					style={`transition-delay: ${i * 90}ms`}
				>
					<div class="reveal-clip overflow-hidden" style={`transition-delay: ${i * 90}ms`}>
						<Image
							src={hobby.image}
							alt={hobby.title}
							width={480}
							height={360}
							class="h-40 w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
						/>
					</div>
					<div class="bg-paper p-5">
						<h3 class="font-semibold text-ink">{hobby.title}</h3>
						<p class="mt-2 text-sm text-ink/60">{hobby.text}</p>
					</div>
				</div>
			))
		}
	</div>
</section>
